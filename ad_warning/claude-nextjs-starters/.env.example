# Notion 연동 (서버 전용 - NEXT_PUBLIC_ 접두사를 붙이지 마세요)
# 실제 값은 .env.local 에 작성하고 커밋하지 않습니다.

# Notion Integration 토큰 (https://www.notion.so/profile/integrations)
# 필요한 Capability: Read content / Insert content / Update content
NOTION_TOKEN=secret_xxx

# 광고 성과 CSV를 가져온(Import) Notion 부모 페이지 ID (URL 끝의 32자리 해시)
# 이 페이지 하위의 데이터베이스(child_database)를 성과 데이터로 읽습니다.
# 부모 페이지의 "연결(Connections)"에 Integration을 추가하면 하위 데이터베이스도 접근 가능합니다.
NOTION_PARENT_PAGE_ID=<PARENT_PAGE_ID>

# 이슈 티켓을 생성할 Notion 데이터베이스 ID (URL의 32자리 해시, ?v= 앞부분)
# 부모 페이지 하위에 있더라도 성과 데이터 탐색에서는 제외됩니다.
# 이 데이터베이스에도 Integration을 연결해야 합니다.
NOTION_DATABASE_ID=<DATABASE_ID>

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
# 서버 전용 - RLS를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이거나 커밋하지 마세요
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
